# ==============================================================================
# S.S JEWELLERY ERP — Environment Variables Template
# Copy this file to .env and fill in your environment-specific credentials.
# NEVER commit your actual .env file to source control.
# ==============================================================================

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Server Port
PORT=3000

# ------------------------------------------------------------------------------
# Database Configuration (Supabase / PostgreSQL)
# ------------------------------------------------------------------------------
# DATABASE_URL: Transaction-pooled connection string (used by the running application)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# DIRECT_URL: Direct database connection string (used by Prisma migrations & seed)
DIRECT_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres"

# ------------------------------------------------------------------------------
# Authentication & Security
# ------------------------------------------------------------------------------
# Minimum 32-character random string used to sign JWT session cookies
JWT_SECRET="replace-with-a-secure-random-32-character-secret"

# Initial password for the master admin account on bootstrap
ADMIN_INITIAL_PASSWORD="ChangeMeInProduction123!"

# ------------------------------------------------------------------------------
# Telemetry & Monitoring (Optional)
# ------------------------------------------------------------------------------
# SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"

# ------------------------------------------------------------------------------
# Shop & Application Defaults
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="S.S JEWELLERY ERP"
NEXT_PUBLIC_DEFAULT_CURRENCY="₹"
NEXT_PUBLIC_DEFAULT_BRANCH="Main Branch"
